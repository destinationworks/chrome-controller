{
  "name": "chrome-controller",
  "version": "1.0.0",
  "description": "Local Chrome control bridge — Pi extension + MCP server + WebSocket/HTTP relay",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node scripts/start.mjs",
    "start:fresh": "node scripts/start.mjs",
    "mcp": "node dist/mcp.js",
    "test": "npx tsx --test src/server.test.ts src/index.test.ts src/mcp.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings 0"
  },
  "pi": {
    "extensions": [
      "src/index.ts"
    ],
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.16.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.7.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
