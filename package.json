{
  "name": "chrome-controller",
  "version": "1.3.2",
  "description": "Local Chrome control bridge — Pi/AGY extension + MCP server + Native Messaging IPC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/destinationworks/chrome-controller.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node scripts/start.js",
    "start:fresh": "node scripts/start.js",
    "native-host": "node dist/native-host.js",
    "install-host": "node scripts/install-native-host.js",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-store-artwork": "node scripts/generate-store-assets.js",
    "capture-store-screenshot": "node scripts/capture-store-screenshot.js",
    "generate-store-assets": "npm run generate-store-artwork && npm run capture-store-screenshot",
    "package": "npm run generate-icons && node scripts/package-extension.js",
    "store:publish": "node scripts/store-publish.js",
    "mcp": "node dist/mcp.js",
    "test": "NODE_ENV=test npx tsx --test src/native-host.test.ts src/chrome-wait.test.ts src/watchdog.test.ts src/server.test.ts src/index.test.ts src/index-ipc.test.ts src/mcp.test.ts src/store-assets.test.ts src/manifest.test.ts src/content-overlay.test.ts src/secure-extraction.test.ts src/extension-background.test.ts src/store-publish.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test 'scripts/store-*.js' --max-warnings 0",
    "watchdog": "node dist/watchdog.js"
  },
  "pi": {
    "extensions": [
      "src/index.ts"
    ],
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.16.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.7.0",
    "playwright-core": "^1.62.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
