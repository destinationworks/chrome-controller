{
  "manifest_version": 3,
  "name": "p agent extension",
  "version": "1.2.0",
  "description": "Local browser control bridge for AI agents via Native Messaging",
  "author": "dst.works@gmail.com",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "tabs",
    "debugger",
    "tabGroups",
    "alarms",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}
