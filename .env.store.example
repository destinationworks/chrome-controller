# Chrome Web Store API credentials for `npm run store:publish -- --upload/--submit`.
# Copy to .env.store (ignored by git) and point each reference at your 1Password item;
# `op run --env-file=.env.store -- ...` resolves them without writing secrets to disk.
CWS_CLIENT_ID="op://Private/Chrome Web Store API/client_id"
CWS_CLIENT_SECRET="op://Private/Chrome Web Store API/client_secret"
CWS_REFRESH_TOKEN="op://Private/Chrome Web Store API/refresh_token"
