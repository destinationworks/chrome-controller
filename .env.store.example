# Optional: Chrome Web Store API credentials from 1Password instead of the macOS Keychain
# (see docs/store-publishing.md). Copy to .env.store (ignored by git), point each reference
# at your item, and run `op run --env-file=.env.store -- npm run store:publish -- ...`.
CWS_CLIENT_ID="op://Private/Chrome Web Store API/client_id"
CWS_CLIENT_SECRET="op://Private/Chrome Web Store API/client_secret"
CWS_REFRESH_TOKEN="op://Private/Chrome Web Store API/refresh_token"
