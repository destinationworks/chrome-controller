{
  "manifest_version": 3,
  "name": "Chrome Controller",
  "version": "1.0",
  "description": "Allows local control of Chrome via WebSocket.",
  "permissions": [
    "tabs",
    "windows",
    "scripting",
    "sessions",
    "activeTab",
    "storage",
    "cookies",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}
